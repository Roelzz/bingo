# Copy to .env and fill in. The admin account is created on first start.
ADMIN_EMAIL=roel@example.com
ADMIN_PASSWORD=kies-een-sterk-wachtwoord
ADMIN_NICKNAME=Roel

# Set to 1 once to overwrite the admin password from ADMIN_PASSWORD, then back to 0.
ADMIN_RESET_PASSWORD=0

# "auto" = Secure cookie when the site runs on HTTPS (also behind Coolify's proxy).
COOKIE_SECURE=auto

# Contact address sent to push services (Apple, Google, Mozilla). Defaults to mailto:ADMIN_EMAIL.
# VAPID_SUBJECT=mailto:roel@example.com

# Where the database, photos and push keys live. Leave as is in Docker.
# DATA_DIR=/data

# Every start saves a rolling snapshot of the database in $DATA_DIR/backups (0 = off).
# DB_SNAPSHOT_KEEP=5
